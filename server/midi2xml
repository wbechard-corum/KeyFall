#!/usr/bin/env python3
"""Convert a single MIDI file to MusicXML using music21.

Usage: midi2xml INPUT.mid OUTPUT.musicxml

Exits 0 on success. On failure, prints a one-line error of the form
    midi2xml ERROR <ExceptionType>: <message>
to stderr and exits 1, so the caller can surface a useful message
without needing to parse a Python traceback.
"""
import sys
import traceback

if len(sys.argv) != 3:
    sys.exit("usage: midi2xml INPUT.mid OUTPUT.musicxml")

src, dst = sys.argv[1], sys.argv[2]

try:
    from music21 import converter
    score = converter.parse(src)
    # Some MIDIs decode but contain no parts/notes — write would
    # silently produce a near-empty XML. Catch that explicitly.
    if not score.parts:
        raise RuntimeError("MIDI has no parts after parsing")
    score.write("musicxml", fp=dst)
except SystemExit:
    raise
except BaseException as e:
    print(f"midi2xml ERROR {type(e).__name__}: {e}", file=sys.stderr)
    # Also print the traceback for the container logs so the full
    # context is available even though only the one-liner reaches
    # the UI.
    traceback.print_exc(file=sys.stderr)
    sys.exit(1)
